# Byte-compiled / optimized Python files
__pycache__/
*.py[co]
*$py.class

# C extensions
*.so

# Virtual environment
.venv/
venv/
env/
ENV/

# Python packages
*.egg-info
*.egg

# Logs and temporary files
*.log
*.tmp
*.bak
*.swp
*~

# IDE/Editor specific
.idea/
.vscode/
*.iml
*.sublime-project
*.sublime-workspace

# Node.js
node_modules/
npm-debug.log*

# AWS
.aws/
aws-sam/

# Docker
Dockerfile.dev
docker-compose.yml
docker-compose.override.yml
.dockerignore

# Kubernetes
*.yaml.orig
*.yml.orig

# Tests
**/__pycache__
*.pytest_cache
.coverage
htmlcov/
.tox/

#Secrets (Ideally, these would be separate from the repo, but adding for completeness)
.env
*.key
*.pem

# Data files (these might be important; exclude only if unnecessary)
*.csv
*.json
*.sqlite  # Or other database files used only for local development

# Build output
dist/
build/
*.whl
.eggs/

# Python Dependency lock files
requirements.txt  # Lockfile for pip, if used.
Pipfile*
